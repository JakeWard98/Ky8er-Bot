# Refuse `npm install` / `npm ci` on a Node.js runtime outside "engines" in
# package.json — i.e. any release without the 2026-11-11 security fixes
# (CVE-2026-123864, TLSWrap use-after-free, CVSS 8.1) and the 2026-10-21
# ones (CVE-2026-111497 "Node2Shell"). setup.sh enforces the same floor.
engine-strict=true
